---
import QuizLabBody from '../components/pages/QuizLabBody.astro'

// /quiz-lab/: the tree review sheet. Built in development and in noindex
// previews (GitHub Pages sets NOINDEX=true), never in the production build.
export function getStaticPaths() {
  const enabled = import.meta.env.DEV || import.meta.env.NOINDEX === 'true'
  return enabled ? [{ params: { lab: 'quiz-lab' } }] : []
}
---

<QuizLabBody />
