---
import '../styles/global.css'
import Nav from '../components/Nav.astro'
import Footer from '../components/Footer.astro'
import StructuredData from '../components/StructuredData.astro'
import type { Locale } from '../lib/content'
import { home } from '../i18n/pages'
import { ogUrlFor } from '../lib/og'
import type { JsonLdNode } from '../lib/structuredData'

interface Props {
  locale: Locale
  title: string
  description: string
  /** Path relative to the locale root, e.g. "/manifesti/" — same across all locales. */
  path: string
  /** For a page that's reachable but intentionally kept out of search results. */
  noindex?: boolean
  /** "article" for a program or blog post; "website" for the standing pages. */
  ogType?: 'website' | 'article'
  /** Only meaningful with ogType="article" — drives the article:* meta. */
  publishedTime?: Date
  modifiedTime?: Date
  /** Page-specific JSON-LD nodes; the Organization is always added for you. */
  jsonLd?: JsonLdNode[]
}

const {
  locale,
  title,
  description,
  path,
  noindex = false,
  ogType = 'website',
  publishedTime,
  modifiedTime,
  jsonLd = [],
} = Astro.props

const SITE_URL = 'https://markkinavihreat.fi'
const localeUrl = (l: Locale) => (l === 'fi' ? `${SITE_URL}${path}` : `${SITE_URL}/${l}${path}`)

// Facebook-style locale codes. Both minority-language editions target Finland.
const OG_LOCALE: Record<Locale, string> = { fi: 'fi_FI', sv: 'sv_FI', en: 'en_GB' }
const otherLocales = (['fi', 'sv', 'en'] as const).filter((l) => l !== locale)

// Per-page Open Graph image, generated at build time by
// src/pages/images/og/[slug].png.ts. Emitted only for indexable pages, so the
// image endpoint's catalog (which also skips noindex pages) always has a match.
const ogImage = ogUrlFor(locale, path)
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#6EB82A" />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="markkinavihreat.fi" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={localeUrl(locale)} />
    <meta property="og:locale" content={OG_LOCALE[locale]} />
    {otherLocales.map((l) => <meta property="og:locale:alternate" content={OG_LOCALE[l]} />)}
    {
      ogType === 'article' && publishedTime && (
        <meta property="article:published_time" content={publishedTime.toISOString()} />
      )
    }
    {
      ogType === 'article' && modifiedTime && (
        <meta property="article:modified_time" content={modifiedTime.toISOString()} />
      )
    }
    {
      !noindex && (
        <>
          <meta property="og:image" content={ogImage} />
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="600" />
          <meta property="og:image:alt" content={title} />
          <meta name="twitter:card" content="summary_large_image" />
          <meta name="twitter:title" content={title} />
          <meta name="twitter:description" content={description} />
          <meta name="twitter:image" content={ogImage} />
        </>
      )
    }
    <link rel="canonical" href={localeUrl(locale)} />
    <link rel="alternate" hreflang="fi" href={localeUrl('fi')} />
    <link rel="alternate" hreflang="sv" href={localeUrl('sv')} />
    <link rel="alternate" hreflang="en" href={localeUrl('en')} />
    <link rel="alternate" hreflang="x-default" href={localeUrl('fi')} />
    <link rel="license" href="https://creativecommons.org/licenses/by-sa/4.0/" />
    <link rel="sitemap" href={`${import.meta.env.BASE_URL}sitemap-index.xml`} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Markkinavihreät"
      href={`${import.meta.env.BASE_URL}rss.xml`}
    />
    {
      noindex || import.meta.env.NOINDEX === 'true' ? (
        <meta name="robots" content="noindex, nofollow" />
      ) : (
        <meta name="robots" content="index, follow, max-image-preview:large" />
      )
    }
    <StructuredData description={home[locale].metaDescription} nodes={jsonLd} />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <link rel="apple-touch-icon" href={`${import.meta.env.BASE_URL}apple-touch-icon.png`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@300;400;500;600;800&display=swap"
      rel="stylesheet"
    />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css"
      crossorigin="anonymous"
      referrerpolicy="no-referrer"
    />
    <!-- Page-specific additions to <head>, e.g. an extra font. -->
    <slot name="head" />
  </head>
  <body>
    <Nav locale={locale} path={path} />
    <main>
      <slot />
    </main>
    <Footer locale={locale} />
  </body>
</html>
