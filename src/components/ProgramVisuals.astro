---
import { assetPath } from '../lib/content'

interface Props {
  heading: string
  intro: string
  downloadLabel: string
  shareLabel: string
  visuals: { src: string; alt: string }[]
}

const { heading, intro, downloadLabel, shareLabel, visuals } = Astro.props
---

<section class="bg-surface-green px-4 py-20 sm:px-6 sm:py-28">
  <div class="content-max mx-auto">
    <h2 class="text-display text-metsa mb-4">{heading}</h2>
    <p class="prose-body mb-10 max-w-[65ch] text-lg">{intro}</p>
    <ul class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
      {
        visuals.map((visual) => (
          <li class="flex flex-col gap-3">
            <img
              src={assetPath(visual.src)}
              alt={visual.alt}
              width="1080"
              height="1080"
              loading="lazy"
              class="rounded-card w-full shadow-md"
            />
            <div class="flex flex-wrap gap-3">
              <button
                type="button"
                hidden
                data-share
                data-src={assetPath(visual.src)}
                data-title={visual.alt}
                class="btn-contained-sm cursor-pointer"
              >
                <i class="fa-solid fa-share-nodes" aria-hidden="true" />
                {shareLabel}
              </button>
              <a href={assetPath(visual.src)} download data-download class="btn-outline-sm">
                <i class="fa-solid fa-download" aria-hidden="true" />
                {downloadLabel}
              </a>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<script>
  // Progressive enhancement: the download link works without JS. Where the
  // browser can share image files (Web Share API level 2), swap it for a
  // single share button.
  const probe = new File([''], 'probe.png', { type: 'image/png' })
  const canShareFiles =
    typeof navigator.canShare === 'function' && navigator.canShare({ files: [probe] })

  if (canShareFiles) {
    document.querySelectorAll<HTMLButtonElement>('[data-share]').forEach((button) => {
      button.hidden = false
      button.parentElement
        ?.querySelector<HTMLElement>('[data-download]')
        ?.setAttribute('hidden', '')
      button.addEventListener('click', async () => {
        const src = button.dataset.src!
        try {
          const blob = await (await fetch(src)).blob()
          const file = new File([blob], src.split('/').pop() ?? 'kuva.png', { type: blob.type })
          await navigator.share({ files: [file] })
        } catch (error) {
          // The user dismissing the share sheet is not an error.
          if (error instanceof DOMException && error.name === 'AbortError') return
          window.open(src, '_blank')
        }
      })
    })
  }
</script>
