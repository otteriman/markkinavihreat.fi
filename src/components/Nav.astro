---
import { LOCALES, localePath, type Locale } from '../lib/content'
import { t } from '../i18n/ui'

interface Props {
  locale: Locale
  path: string
}

const { locale, path } = Astro.props

const links: { key: Parameters<typeof t>[1]; href: string }[] = [
  { key: 'nav.about', href: '/ketka/' },
  { key: 'nav.manifesto', href: '/manifesti/' },
  { key: 'nav.programs', href: '/ehdotukset/' },
  { key: 'nav.blog', href: '/blogi/' },
  { key: 'nav.contact', href: '/yhteystiedot/' },
]

const WHATSAPP_URL = 'https://chat.whatsapp.com/DFBhxqTOmLRHqGgUzupy7L'
const localeLabels: Record<Locale, string> = { fi: 'FI', sv: 'SV', en: 'EN' }
---

<nav class="bg-kerma/95 sticky top-0 z-50 border-b border-transparent backdrop-blur">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-4 sm:px-6">
    <a href={localePath(locale, '/')} class="text-lg font-extrabold">
      markkina<span class="text-vihreat-brand">vihreät</span>.fi
    </a>

    <button
      class="text-2xl sm:hidden"
      aria-expanded="false"
      aria-controls="mobile-menu"
      id="nav-toggle"
    >
      <i class="fa-solid fa-bars" aria-hidden="true"></i>
      <span class="sr-only">Menu</span>
    </button>

    <div class="hidden sm:flex sm:w-auto sm:flex-row sm:items-center sm:gap-6">
      <ul class="flex flex-row items-center gap-6">
        {
          links.map((link) => {
            const isActive = path === link.href || path.startsWith(link.href)
            return (
              <li>
                <a
                  href={localePath(locale, link.href)}
                  aria-current={isActive ? 'page' : undefined}
                  class:list={[
                    'hover:text-vihrea-tumma font-medium underline-offset-4',
                    isActive && 'underline',
                  ]}
                >
                  {t(locale, link.key)}
                </a>
              </li>
            )
          })
        }
      </ul>

      <div class="flex items-center gap-3">
        <a href={WHATSAPP_URL} class="btn-outline-sm" target="_blank" rel="noopener">
          {t(locale, 'nav.whatsapp')}
        </a>
        <div class="flex items-center gap-2" aria-label={t(locale, 'nav.lang')}>
          {
            LOCALES.map((l) => (
              <a
                href={l === locale ? undefined : localePath(l, path)}
                aria-current={l === locale ? 'page' : undefined}
                class:list={[
                  'text-sm font-semibold',
                  l === locale ? 'text-musta' : 'text-harmaa hover:text-musta',
                ]}
              >
                {localeLabels[l]}
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </div>

  <div
    id="mobile-menu"
    class="bg-kerma absolute inset-x-0 top-full grid grid-rows-[0fr] border-b border-transparent shadow-lg transition-[grid-template-rows] duration-300 ease-in-out sm:hidden"
  >
    <div class="min-h-0 overflow-hidden">
      <div class="flex flex-col gap-4 px-4 py-4">
        <ul class="flex flex-col gap-3">
          {
            links.map((link) => {
              const isActive = path === link.href || path.startsWith(link.href)
              return (
                <li>
                  <a
                    href={localePath(locale, link.href)}
                    aria-current={isActive ? 'page' : undefined}
                    class:list={[
                      'hover:text-vihrea-tumma font-medium underline-offset-4',
                      isActive && 'underline',
                    ]}
                  >
                    {t(locale, link.key)}
                  </a>
                </li>
              )
            })
          }
        </ul>

        <div class="flex items-center gap-3">
          <a href={WHATSAPP_URL} class="btn-outline-sm" target="_blank" rel="noopener">
            {t(locale, 'nav.whatsapp')}
          </a>
          <div class="flex items-center gap-2" aria-label={t(locale, 'nav.lang')}>
            {
              LOCALES.map((l) => (
                <a
                  href={l === locale ? undefined : localePath(l, path)}
                  aria-current={l === locale ? 'page' : undefined}
                  class:list={[
                    'text-sm font-semibold',
                    l === locale ? 'text-musta' : 'text-harmaa hover:text-musta',
                  ]}
                >
                  {localeLabels[l]}
                </a>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </div>
</nav>

<script>
  const toggle = document.getElementById('nav-toggle')
  const menu = document.getElementById('mobile-menu')
  const icon = toggle?.querySelector('i')
  toggle?.addEventListener('click', () => {
    const isOpen = menu?.classList.toggle('grid-rows-[1fr]')
    menu?.classList.toggle('grid-rows-[0fr]')
    toggle.setAttribute('aria-expanded', String(Boolean(isOpen)))
    icon?.classList.toggle('fa-bars')
    icon?.classList.toggle('fa-xmark')
  })
</script>
