---
import { getCollection, getEntry } from 'astro:content'
import BaseLayout from '../../layouts/BaseLayout.astro'
import QuoteBand from '../QuoteBand.astro'
import RandomizeQuotes from '../RandomizeQuotes.astro'
import { forLocale, localePath, type Locale } from '../../lib/content'
import { home } from '../../i18n/pages'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const copy = home[locale]
const WHATSAPP_URL = 'https://chat.whatsapp.com/DFBhxqTOmLRHqGgUzupy7L'

// Pool of quote bands drawn from every listed program's citations (see
// content.config.ts). RandomizeQuotes picks a random distinct subset per load
// to fill the fixed slots below, so the quotes vary between visits. The first
// `slots` entries are also rendered server-side as the no-JS fallback.
const allPrograms = await getCollection('programs')
const pool = (
  await Promise.all(
    forLocale(allPrograms, locale)
      .filter((program) => !program.data.unlisted)
      .sort((a, b) => a.data.order - b.data.order)
      .flatMap((program) => program.data.citations)
      .map(async (citation) => {
        const person = await getEntry('team', `${citation.person}.${locale}`)
        if (!person) throw new Error(`Citation references unknown team member "${citation.person}"`)
        return {
          person: citation.person,
          quote: citation.quote,
          name: person.data.name,
          photo: person.data.photo,
        }
      }),
  )
)
  // Dedupe by person so one face can't fill two of the four slots on a load.
  .filter((entry, i, all) => all.findIndex((other) => other.person === entry.person) === i)
---

<BaseLayout
  locale={locale}
  title={`${copy.eyebrow} — markkinavihreat.fi`}
  description={copy.metaDescription}
  path="/"
>
  <section class="content-max mx-auto px-4 py-16 text-center sm:px-6 sm:py-24">
    <p class="text-vihrea-tumma font-semibold">{copy.eyebrow}</p>
    <h1 class="mt-2 text-4xl sm:text-6xl">{copy.title}</h1>
    <p class="text-harmaa mx-auto mt-6 max-w-2xl text-lg">{copy.subtitle}</p>
    <div class="mt-8 flex flex-wrap justify-center gap-4">
      <a href={localePath(locale, '/manifesti/')} class="btn-primary">{copy.ctaManifesto}</a>
      <a href={localePath(locale, '/ehdotukset/')} class="btn-outline-medium">{copy.ctaPrograms}</a>
    </div>
  </section>

  {
    pool[0] && (
      <div class="js-quote-slot">
        <QuoteBand name={pool[0].name} photo={pool[0].photo} quote={pool[0].quote} />
      </div>
    )
  }

  <section class="bg-surface-greige px-4 py-16 sm:px-6">
    <div class="content-max mx-auto">
      <h2 class="text-3xl">{copy.framingTitle}</h2>
      <p class="text-harmaa mt-4 max-w-3xl">{copy.framingBody}</p>
    </div>
  </section>

  {
    pool[1] && (
      <div class="js-quote-slot">
        <QuoteBand name={pool[1].name} photo={pool[1].photo} quote={pool[1].quote} />
      </div>
    )
  }

  <section class="px-4 py-16 sm:px-6">
    <div class="content-max mx-auto grid gap-6 sm:grid-cols-2">
      {
        copy.values.map((value) => (
          <div class="card bg-surface-green">
            <h3 class="text-lg font-extrabold">{value.title}</h3>
            <p class="text-harmaa mt-2">{value.body}</p>
          </div>
        ))
      }
    </div>
  </section>

  {
    pool[2] && (
      <div class="js-quote-slot">
        <QuoteBand name={pool[2].name} photo={pool[2].photo} quote={pool[2].quote} />
      </div>
    )
  }

  <section class="bg-metsa text-kerma px-4 py-16 sm:px-6">
    <div class="content-max mx-auto">
      <h2 class="text-3xl">{copy.exploreTitle}</h2>
      <div class="mt-6 grid gap-4 sm:grid-cols-2">
        <a
          href={localePath(locale, '/manifesti/')}
          class="rounded-card bg-surface-dark-green p-6 hover:-translate-y-1"
        >
          <h3 class="text-lg font-extrabold">{copy.exploreManifesto}</h3>
          <p class="text-kerma/80 mt-1">{copy.exploreManifestoDesc}</p>
        </a>
        <a
          href={localePath(locale, '/ehdotukset/')}
          class="rounded-card bg-surface-dark-green p-6 hover:-translate-y-1"
        >
          <h3 class="text-lg font-extrabold">{copy.explorePrograms}</h3>
          <p class="text-kerma/80 mt-1">{copy.exploreProgramsDesc}</p>
        </a>
        <a
          href={localePath(locale, '/blogi/')}
          class="rounded-card bg-surface-dark-green p-6 hover:-translate-y-1"
        >
          <h3 class="text-lg font-extrabold">{copy.exploreBlog}</h3>
          <p class="text-kerma/80 mt-1">{copy.exploreBlogDesc}</p>
        </a>
        <a
          href={localePath(locale, '/ketka/')}
          class="rounded-card bg-surface-dark-green p-6 hover:-translate-y-1"
        >
          <h3 class="text-lg font-extrabold">{copy.exploreAbout}</h3>
          <p class="text-kerma/80 mt-1">{copy.exploreAboutDesc}</p>
        </a>
      </div>
    </div>
  </section>

  {
    pool[3] && (
      <div class="js-quote-slot">
        <QuoteBand name={pool[3].name} photo={pool[3].photo} quote={pool[3].quote} />
      </div>
    )
  }

  <section class="content-max mx-auto px-4 py-16 text-center sm:px-6">
    <h2 class="text-3xl">{copy.joinTitle}</h2>
    <p class="text-harmaa mx-auto mt-4 max-w-xl">{copy.joinBody}</p>
    <a href={WHATSAPP_URL} class="btn-primary mt-6 inline-flex" target="_blank" rel="noopener">
      {copy.joinCta}
    </a>
  </section>

  <template class="js-quote-pool">
    {pool.map((entry) => <QuoteBand name={entry.name} photo={entry.photo} quote={entry.quote} />)}
  </template>
  <RandomizeQuotes poolSelector=".js-quote-pool" slotSelector=".js-quote-slot" />
</BaseLayout>
