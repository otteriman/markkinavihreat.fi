---
import BaseLayout from '../../layouts/BaseLayout.astro'
import BonusFont from '../BonusFont.astro'
import BonusGame from '../BonusGame.astro'
import FinaleIcon from '../FinaleIcon.astro'
import QuizBars from '../QuizBars.astro'
import type { Locale } from '../../lib/content'
import { items, resultTypes, t as qt } from '../../lib/quiz/data'
import { renderTree } from '../../lib/quiz/tree'
import { questionNumber, scoredCount } from '../../lib/quiz/flow'
import type { Finale, GuessInterlude, Statement } from '../../lib/quiz/types'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const t = (key: string, vars?: Record<string, string | number>) => qt(locale, key, vars)
const total = scoredCount(items)
const SCALE = [-2, -1, 0, 1, 2] as const

// Everything the client script needs that is locale-specific. Question text is
// rendered into the markup below, so the script itself ships no copy.
const config = {
  locale,
  total,
  guess: items.find((i): i is GuessInterlude => i.kind === 'guess')?.answer,
  strings: {
    progress: t('progress.label', { n: '{n}', total }),
    guessOff: t('guess.off', { n: '{n}' }),
    guessOffOne: t('guess.offOne'),
    guessExact: t('guess.exact'),
    overall: t('result.overall', { percent: '{percent}' }),
    revealStatus: t('reveal.status', { percent: '{percent}', type: '{type}' }),
  },
  types: Object.fromEntries(resultTypes.map((r) => [r.slug, r.name[locale]])),
  // Which way an answer moved the tree, shown after each statement.
  cues: Object.fromEntries(
    [
      'freedom.up',
      'freedom.down',
      'markets.up',
      'markets.down',
      'environment.up',
      'environment.down',
      'neutral',
      'skipped',
    ].map((k) => [k, t(`cue.${k}`)]),
  ),
}

const isStatement = (i: (typeof items)[number]): i is Statement => i.kind === 'statement'
const isFinale = (i: (typeof items)[number]): i is Finale => i.kind === 'finale'
const isGuess = (i: (typeof items)[number]): i is GuessInterlude => i.kind === 'guess'

const btnAnswer =
  'btn-outline-medium w-full justify-center aria-pressed:bg-musta aria-pressed:text-kerma'
---

<BaseLayout
  locale={locale}
  title={`${t('intro.title')} — markkinavihreat.fi`}
  description={t('intro.lead')}
  path="/testi/"
  noindex
>
  <BonusFont slot="head" />
  <div
    id="quiz"
    data-locale={locale}
    class="content-max mx-auto flex min-h-[calc(100svh-4rem)] scroll-mt-16 flex-col px-4 py-6 sm:px-6"
  >
    <!-- The growing tree is the progress indicator (plan section 7.3). It is
         decorative; screen readers get "Question n of 10" from #quiz-status. -->
    <div id="quiz-tree-wrap" class="quiz-tree-wrap mx-auto w-full" aria-hidden="true">
      <div
        id="quiz-tree"
        class="aspect-[6/5]"
        set:html={renderTree({ growth: 0, markets: 50, environment: 50, freedom: 50 })}
      />
    </div>
    <p id="quiz-status" class="sr-only" aria-live="polite"></p>

    <section data-step="intro" class="flex flex-1 flex-col justify-between gap-8 py-8">
      <div>
        <h1 data-heading tabindex="-1" class="text-4xl sm:text-5xl">{t('intro.title')}</h1>
        <p class="mt-6 text-lg">{t('intro.lead')}</p>
        <p class="text-harmaa mt-4 text-sm">{t('intro.notVaa')}</p>
      </div>
      <button type="button" data-action="start" class="btn-primary w-full justify-center">
        {t('intro.start')}
      </button>
    </section>

    {
      items.map((item) => {
        const num = questionNumber(items, item.id)
        return (
          <>
            <section
              data-step={`q:${item.id}`}
              hidden
              class="flex flex-1 flex-col justify-between gap-5 py-2 sm:gap-6 sm:py-4"
            >
              <div>
                <p class="text-eyebrow text-harmaa">
                  {num ? t('progress.label', { n: num, total }) : ' '}
                </p>
                <h2 data-heading tabindex="-1" class="mt-2 text-xl sm:mt-3 sm:text-3xl">
                  {item.text[locale]}
                </h2>
              </div>

              <div class="space-y-3">
                {isStatement(item) && (
                  <div class="space-y-2" role="group" aria-label={item.text[locale]}>
                    {SCALE.map((v) => (
                      <button type="button" data-answer={v} class={btnAnswer}>
                        {t(`scale.${v}`)}
                      </button>
                    ))}
                  </div>
                )}

                {isGuess(item) && (
                  <div>
                    <p class="text-center text-4xl font-extrabold" data-guess-value>
                      {Math.round((item.min + item.max) / 2)}
                    </p>
                    <input
                      type="range"
                      min={item.min}
                      max={item.max}
                      step="1"
                      value={Math.round((item.min + item.max) / 2)}
                      data-guess-slider
                      aria-label={item.text[locale]}
                      class="accent-vihrea-tumma mt-3 w-full"
                    />
                    <div class="text-harmaa flex justify-between text-xs" aria-hidden="true">
                      <span>{item.min}</span>
                      <span>{item.max}</span>
                    </div>
                  </div>
                )}

                {isFinale(item) && (
                  <div class="grid gap-3" role="group" aria-label={t('finale.choices')}>
                    {item.options.map((o) => (
                      <button
                        type="button"
                        data-option={o.id}
                        class="card hover:bg-surface-green aria-pressed:bg-musta aria-pressed:text-kerma flex min-h-24 items-center gap-4 bg-white text-left text-lg font-semibold"
                      >
                        <FinaleIcon option={o.id} />
                        <span>{o.label[locale]}</span>
                      </button>
                    ))}
                  </div>
                )}

                <div class="flex items-center justify-between gap-3 pt-2">
                  <button type="button" data-action="back" class="btn-outline-sm">
                    {t('nav.back')}
                  </button>
                  {isGuess(item) && (
                    <button type="button" data-action="next" class="btn-primary">
                      {t('nav.next')}
                    </button>
                  )}
                  {isStatement(item) && (
                    <button type="button" data-action="skip" class="btn-outline-sm">
                      {t('nav.skip')}
                    </button>
                  )}
                </div>
              </div>
            </section>

            {isStatement(item) && (
              <section
                data-step={`a:${item.id}`}
                hidden
                class="flex flex-1 flex-col justify-between gap-6 py-4"
              >
                {/* The tree grows above; this says what the answer indicated. Filled in by the script. */}
                <p
                  data-cue
                  data-heading
                  tabindex="-1"
                  class="quiz-cue mx-auto max-w-sm text-center text-2xl font-extrabold text-balance"
                />
                <button
                  type="button"
                  data-action="continue"
                  class="btn-primary w-full justify-center"
                >
                  {t('nav.continue')}
                </button>
              </section>
            )}

            {isGuess(item) && (
              <section
                data-step={`a:${item.id}`}
                hidden
                class="flex flex-1 flex-col justify-between gap-6 py-4"
              >
                <div data-card class="card bg-white">
                  <h2 data-heading tabindex="-1" class="text-2xl sm:text-3xl">
                    {item.reveal[locale]}
                  </h2>
                  <p
                    class="mt-6 text-center text-4xl font-extrabold"
                    data-reveal-year
                    aria-hidden="true"
                  >
                    {item.answer}
                  </p>
                  <input
                    type="range"
                    min={item.min}
                    max={item.max}
                    step="1"
                    value={item.answer}
                    data-reveal-slider
                    disabled
                    tabindex="-1"
                    aria-hidden="true"
                    class="accent-vihrea-tumma mt-3 w-full"
                  />
                  <div class="text-harmaa flex justify-between text-xs" aria-hidden="true">
                    <span>{item.min}</span>
                    <span>{item.max}</span>
                  </div>
                  <p class="text-harmaa mt-3 text-sm">
                    {t('guess.yourGuess')}: <span data-your-guess />
                  </p>
                  <p data-guess-result class="mt-2 text-lg font-semibold" />
                </div>
                <button
                  type="button"
                  data-action="continue"
                  class="btn-primary w-full justify-center"
                >
                  {t('nav.continue')}
                </button>
              </section>
            )}
          </>
        )
      })
    }

    <!-- The result reveal (plan section 7.3), then on to the static result page. -->
    <!-- Laid out like the top of the result page, so the hand-over to it is seamless. -->
    <section data-step="reveal" hidden class="flex flex-1 flex-col py-4">
      <p data-reveal-drumroll class="text-eyebrow text-harmaa">{t('finale.drumroll')}</p>
      <p data-reveal-percent class="text-display-lg mt-2 tabular-nums" aria-hidden="true">
        {t('result.overall', { percent: 0 })}
      </p>
      <h2
        data-heading
        data-reveal-type
        tabindex="-1"
        class="mt-2 text-3xl opacity-0 transition-opacity duration-500 motion-reduce:transition-none sm:text-4xl"
      >
      </h2>
      <div class="mt-6">
        <QuizBars locale={locale} group="reveal" />
      </div>
      <p data-reveal-status class="sr-only" aria-live="polite"></p>
      <a data-reveal-link href={`#`} class="btn-primary mt-6 justify-center">{t('reveal.see')}</a>
    </section>

    <BonusGame locale={locale} />

    <script type="application/json" id="quiz-config" is:inline set:html={JSON.stringify(config)} />
  </div>
</BaseLayout>

<script>
  import { initQuiz } from '../../scripts/quiz/init'
  initQuiz()
</script>

<style>
  /* The tree is off screen while a question is shown, so the answers fit
     without scrolling; it appears after each answer and grows for the reveal. */
  .quiz-tree-wrap {
    max-width: 20rem;
    transition: max-width 0.6s ease;
  }
  .quiz-tree-wrap.is-intro,
  .quiz-tree-wrap.is-reveal {
    max-width: 24rem;
  }
  /* The growth cue rises in once the tree has started to grow. */
  [data-step]:not([hidden]) .quiz-cue {
    animation: quiz-cue-in 0.5s ease-out 0.35s both;
  }
  @keyframes quiz-cue-in {
    from {
      opacity: 0;
      transform: translateY(12px) scale(0.96);
    }
  }
  /* After-question cards slide in. */
  [data-step]:not([hidden]) [data-card] {
    animation: quiz-card-in 0.35s ease-out;
  }
  @keyframes quiz-card-in {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .quiz-tree-wrap,
    [data-step]:not([hidden]) .quiz-cue,
    [data-step]:not([hidden]) [data-card] {
      transition: none;
      animation: none;
    }
  }
</style>

<style is:global>
  /* Quiz → result page: a cross-document view transition. The tree, the
     percentage and the type name glide to their places on the result page and
     everything else cross-fades, instead of the page visibly reloading.
     Browsers without support simply navigate. */
  @view-transition {
    navigation: auto;
  }
  #quiz-tree-wrap {
    view-transition-name: quiz-tree;
  }
  [data-reveal-percent] {
    view-transition-name: quiz-percent;
  }
  [data-reveal-type] {
    view-transition-name: quiz-type;
  }
  @media (prefers-reduced-motion: reduce) {
    @view-transition {
      navigation: none;
    }
  }
</style>
