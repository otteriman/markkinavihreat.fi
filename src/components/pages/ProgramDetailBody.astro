---
import { getEntry, type CollectionEntry } from 'astro:content'
import BaseLayout from '../../layouts/BaseLayout.astro'
import ProgramFaq from '../ProgramFaq.astro'
import ProgramHero from '../ProgramHero.astro'
import ProgramSection from '../ProgramSection.astro'
import QuoteBand from '../QuoteBand.astro'
import ShuffleOnLoad from '../ShuffleOnLoad.astro'
import { parseLocalizedId, type Locale } from '../../lib/content'
import { assignSectionTones, parseProgramBody } from '../../lib/programSections'
import { t } from '../../i18n/ui'

interface Props {
  locale: Locale
  program: CollectionEntry<'programs'>
}

const { locale, program } = Astro.props
const path = `/ehdotukset/${parseLocalizedId(program.id).slug}/`
const { leadParagraphs, sections } = parseProgramBody(program.body ?? '')

const citations = await Promise.all(
  program.data.citations.map(async (citation) => {
    const person = await getEntry('team', `${citation.person}.${locale}`)
    if (!person) throw new Error(`Citation references unknown team member "${citation.person}"`)
    return { quote: citation.quote, name: person.data.name, photo: person.data.photo }
  }),
)

const JOIN_URL = 'https://www.vihreat.fi/liity/'

const tones = assignSectionTones(sections)

// The join CTA belongs on the closing summary, which is the last "highlight"
// section — not necessarily the last section overall, since an FAQ block (if
// present) always comes after it.
let lastHighlightIndex = -1
sections.forEach((section, i) => {
  if (section.type === 'highlight') lastHighlightIndex = i
})
---

<BaseLayout
  locale={locale}
  title={`${program.data.title} — markkinavihreat.fi`}
  description={program.data.description}
  path={path}
  noindex={program.data.unlisted}
>
  <ProgramHero
    kicker={program.data.heroKicker}
    lines={program.data.heroLines}
    leadParagraphs={leadParagraphs}
  />

  {
    sections.map((section, i) => {
      if (section.type === 'faq') {
        return <ProgramFaq heading={section.heading} items={section.items} />
      }

      const tone = tones[i]
      const citation = citations[i]
      return (
        <>
          <ProgramSection
            tone={tone}
            label={
              section.type === 'requirement' || section.type === 'highlight'
                ? section.label
                : undefined
            }
            heading={section.heading}
            paragraphs={section.paragraphs}
            locale={locale}
          >
            {i === lastHighlightIndex && (
              <a href={JOIN_URL} class="btn-contained-lg mt-10 inline-flex">
                {t(locale, 'programs.joinCta')}
              </a>
            )}
          </ProgramSection>
          {citation && (
            <QuoteBand
              class="js-quote-band"
              name={citation.name}
              photo={citation.photo}
              quote={citation.quote}
            />
          )}
        </>
      )
    })
  }

  {
    citations
      .slice(sections.length)
      .map((citation) => (
        <QuoteBand
          class="js-quote-band"
          name={citation.name}
          photo={citation.photo}
          quote={citation.quote}
        />
      ))
  }

  <ShuffleOnLoad selector=".js-quote-band" />
</BaseLayout>
