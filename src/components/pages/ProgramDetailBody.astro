---
import { getEntry, type CollectionEntry } from 'astro:content'
import BaseLayout from '../../layouts/BaseLayout.astro'
import ProgramFaq from '../ProgramFaq.astro'
import ProgramHero from '../ProgramHero.astro'
import ProgramVisuals from '../ProgramVisuals.astro'
import ProgramSection from '../ProgramSection.astro'
import QuoteBand from '../QuoteBand.astro'
import ShuffleOnLoad from '../ShuffleOnLoad.astro'
import { parseLocalizedId, type Locale } from '../../lib/content'
import {
  parseProgramBody,
  type ProgramSection as ProgramSectionData,
} from '../../lib/programSections'
import { t } from '../../i18n/ui'
import { programsPage } from '../../i18n/pages'
import { localePath } from '../../lib/content'
import { ogUrlFor } from '../../lib/og'
import {
  articleNode,
  breadcrumbNode,
  faqNode,
  SITE_URL,
  type JsonLdNode,
} from '../../lib/structuredData'

interface Props {
  locale: Locale
  program: CollectionEntry<'programs'>
}

const { locale, program } = Astro.props
const path = `/ehdotukset/${parseLocalizedId(program.id).slug}/`
const { leadParagraphs, sections } = parseProgramBody(program.body ?? '')

const citations = await Promise.all(
  program.data.citations.map(async (citation) => {
    const person = await getEntry('team', `${citation.person}.${locale}`)
    if (!person) throw new Error(`Citation references unknown team member "${citation.person}"`)
    return { quote: citation.quote, name: person.data.name, photo: person.data.photo }
  }),
)

const JOIN_URL = 'https://www.vihreat.fi/liity/'

// Numbered requirement bands alternate between two backgrounds; the framing
// intro and closing summary always use the dark highlight band.
function toneFor(section: ProgramSectionData, requirementPosition: number) {
  if (section.type === 'requirement') return requirementPosition % 2 === 0 ? 'light' : 'tint'
  return 'dark'
}

let requirementPosition = 0

// The join CTA belongs on the closing summary, which is the last "highlight"
// section — not necessarily the last section overall, since an FAQ block (if
// present) always comes after it.
let lastHighlightIndex = -1
sections.forEach((section, i) => {
  if (section.type === 'highlight') lastHighlightIndex = i
})

const canonical = `${SITE_URL}${localePath(locale, path)}`
const indexable = !program.data.unlisted

const jsonLd: JsonLdNode[] = [
  articleNode({
    url: canonical,
    headline: program.data.title,
    description: program.data.description,
    locale,
    image: ogUrlFor(locale, path),
    published: program.data.published,
    updated: program.data.updated,
  }),
  breadcrumbNode([
    { name: 'Markkinavihreät', url: `${SITE_URL}${localePath(locale, '/')}` },
    { name: programsPage[locale].title, url: `${SITE_URL}${localePath(locale, '/ehdotukset/')}` },
    { name: program.data.title, url: canonical },
  ]),
]

// Only emitted once a program's FAQ is genuinely complete — see faqNode().
const faqSection = sections.find((section) => section.type === 'faq')
const faq = faqSection ? faqNode(faqSection.items, { indexable }) : null
if (faq) jsonLd.push(faq)
---

<BaseLayout
  locale={locale}
  title={`${program.data.title} — markkinavihreat.fi`}
  description={program.data.description}
  path={path}
  noindex={program.data.unlisted}
  ogType="article"
  publishedTime={program.data.published}
  modifiedTime={program.data.updated}
  jsonLd={jsonLd}
>
  <ProgramHero
    kicker={program.data.heroKicker}
    lines={program.data.heroLines}
    leadParagraphs={leadParagraphs}
  />

  {
    sections.map((section, i) => {
      if (section.type === 'faq') {
        return <ProgramFaq heading={section.heading} items={section.items} />
      }

      const tone = toneFor(section, section.type === 'requirement' ? requirementPosition++ : 0)
      const citation = citations[i]
      return (
        <>
          <ProgramSection
            tone={tone}
            label={section.type === 'requirement' ? section.label : undefined}
            heading={section.heading}
            paragraphs={section.paragraphs}
          >
            {i === lastHighlightIndex && (
              <a href={JOIN_URL} class="btn-contained-lg mt-10 inline-flex">
                {t(locale, 'programs.joinCta')}
              </a>
            )}
          </ProgramSection>
          {citation && (
            <QuoteBand
              class="js-quote-band"
              name={citation.name}
              photo={citation.photo}
              quote={citation.quote}
            />
          )}
        </>
      )
    })
  }

  {
    citations
      .slice(sections.length)
      .map((citation) => (
        <QuoteBand
          class="js-quote-band"
          name={citation.name}
          photo={citation.photo}
          quote={citation.quote}
        />
      ))
  }

  {
    program.data.visuals.length > 0 && (
      <ProgramVisuals
        heading={t(locale, 'programs.visualsHeading')}
        intro={t(locale, 'programs.visualsIntro')}
        downloadLabel={t(locale, 'programs.visualsDownload')}
        shareLabel={t(locale, 'programs.visualsShare')}
        visuals={program.data.visuals}
      />
    )
  }

  <ShuffleOnLoad selector=".js-quote-band" />
</BaseLayout>
