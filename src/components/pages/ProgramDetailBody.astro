---
import { getEntry, type CollectionEntry } from 'astro:content'
import BaseLayout from '../../layouts/BaseLayout.astro'
import ProgramFaq from '../ProgramFaq.astro'
import ProgramHero from '../ProgramHero.astro'
import ProgramDraftNotice from '../ProgramDraftNotice.astro'
import ProgramSection from '../ProgramSection.astro'
import ProgramCreators from '../ProgramCreators.astro'
import ProgramSlides from '../ProgramSlides.astro'
import QuoteBand from '../QuoteBand.astro'
import ShuffleOnLoad from '../ShuffleOnLoad.astro'
import { parseLocalizedId, type Locale } from '../../lib/content'
import {
  assignSectionTones,
  parseProgramBody,
  type ProgramParagraph,
} from '../../lib/programSections'
import { t } from '../../i18n/ui'
import { programsPage } from '../../i18n/pages'
import { localePath } from '../../lib/content'
import { ogUrlFor } from '../../lib/og'
import { personPath } from '../../lib/team'
import {
  articleNode,
  breadcrumbNode,
  faqNode,
  SITE_URL,
  type JsonLdNode,
} from '../../lib/structuredData'

interface Props {
  locale: Locale
  program: CollectionEntry<'programs'>
}

const { locale, program } = Astro.props
const path = `/ehdotukset/${parseLocalizedId(program.id).slug}/`
const { leadParagraphs, sections } = parseProgramBody(program.body ?? '')

const citations = await Promise.all(
  program.data.citations.map(async (citation, i) => {
    const person = await getEntry('team', `${citation.person}.${locale}`)
    if (!person) throw new Error(`Citation references unknown team member "${citation.person}"`)
    return {
      afterSection: citation.afterSection ?? i,
      afterParagraph: citation.afterParagraph,
      // A quote placed by hand stays put; only unplaced ones join the shuffle.
      pinned: citation.afterSection !== undefined || citation.afterParagraph !== undefined,
      quote: citation.quote,
      name: person.data.name,
      photo: person.data.photo,
      href: personPath(locale, citation.person),
    }
  }),
)

type Citation = (typeof citations)[number]

// Splits a section at the quotes placed inside it (afterParagraph), so each
// such quote band sits between two parts of the same section. The last part
// carries the quotes that follow the whole section.
function sectionParts(paragraphs: ProgramParagraph[], quotes: Citation[]) {
  const inside = quotes.filter(
    (c) => c.afterParagraph !== undefined && c.afterParagraph < paragraphs.length,
  )
  const cuts = [...new Set(inside.map((c) => c.afterParagraph!))].sort((a, b) => a - b)
  const parts: Array<{ start: number; paragraphs: typeof paragraphs; quotes: Citation[] }> = []
  let start = 0
  for (const cut of cuts) {
    parts.push({
      start,
      paragraphs: paragraphs.slice(start, cut),
      quotes: inside.filter((c) => c.afterParagraph === cut),
    })
    start = cut
  }
  parts.push({
    start,
    paragraphs: paragraphs.slice(start),
    quotes: quotes.filter((c) => !inside.includes(c)),
  })
  return parts
}

const contributors = await Promise.all(
  program.data.contributors.map(async (slug) => {
    const person = await getEntry('team', `${slug}.${locale}`)
    if (!person) throw new Error(`Program lists unknown contributor "${slug}"`)
    return { name: person.data.name, href: personPath(locale, slug) }
  }),
)

// Alphabetical in the HTML, so the order without JavaScript favours no one;
// ShuffleOnLoad below then randomises it on every load.
const creators = (
  await Promise.all(
    program.data.creators.map(async (slug) => {
      const person = await getEntry('team', `${slug}.${locale}`)
      if (!person) throw new Error(`Program lists unknown creator "${slug}"`)
      return {
        name: person.data.name,
        photo: person.data.avatar ?? person.data.photo,
        href: personPath(locale, slug),
      }
    }),
  )
).sort((a, b) => a.name.localeCompare(b.name, 'fi'))

const JOIN_URL = 'https://www.vihreat.fi/liity/'

const tones = assignSectionTones(sections)

// The join CTA belongs on the closing summary, which is the last "highlight"
// section — not necessarily the last section overall, since an FAQ block (if
// present) always comes after it.
let lastHighlightIndex = -1
sections.forEach((section, i) => {
  if (section.type === 'highlight') lastHighlightIndex = i
})

const canonical = `${SITE_URL}${localePath(locale, path)}`
const indexable = !program.data.unlisted

const jsonLd: JsonLdNode[] = [
  articleNode({
    url: canonical,
    headline: program.data.title,
    description: program.data.description,
    locale,
    image: ogUrlFor(locale, path),
    published: program.data.published,
    updated: program.data.updated,
  }),
  breadcrumbNode([
    { name: 'Markkinavihreät', url: `${SITE_URL}${localePath(locale, '/')}` },
    { name: programsPage[locale].title, url: `${SITE_URL}${localePath(locale, '/ehdotukset/')}` },
    { name: program.data.title, url: canonical },
  ]),
]

// Only emitted once a program's FAQ is genuinely complete — see faqNode().
const faqSection = sections.find((section) => section.type === 'faq')
const faq = faqSection ? faqNode(faqSection.items, { indexable }) : null
if (faq) jsonLd.push(faq)
---

<BaseLayout
  locale={locale}
  title={`${program.data.title} — markkinavihreat.fi`}
  description={program.data.description}
  path={path}
  noindex={program.data.unlisted}
  ogType="article"
  publishedTime={program.data.published}
  modifiedTime={program.data.updated}
  jsonLd={jsonLd}
>
  <ProgramHero
    kicker={program.data.heroKicker}
    lines={program.data.heroLines}
    leadParagraphs={leadParagraphs}
  />

  {
    program.data.draftNotice && (
      <ProgramDraftNotice
        label={t(locale, 'programs.draftLabel')}
        title={program.data.draftNotice.title}
        body={program.data.draftNotice.body}
        checks={program.data.draftNotice.checks}
      />
    )
  }

  {
    creators.length > 0 && (
      <ProgramCreators label={t(locale, 'programs.creators')} people={creators} />
    )
  }

  {
    sections.map((section, i) => {
      if (section.type === 'faq') {
        return <ProgramFaq heading={section.heading} items={section.items} />
      }

      const tone = tones[i]
      const parts = sectionParts(
        section.paragraphs,
        citations.filter((c) => c.afterSection === i),
      )
      return parts.map((part, p) => (
        <>
          <ProgramSection
            tone={tone}
            label={
              p === 0 && (section.type === 'requirement' || section.type === 'highlight')
                ? section.label
                : undefined
            }
            heading={p === 0 ? section.heading : undefined}
            paragraphs={part.paragraphs}
            firstParagraphIndex={part.start}
            locale={locale}
          >
            {i === lastHighlightIndex && p === parts.length - 1 && (
              <a href={JOIN_URL} class="btn-contained-lg mt-10 inline-flex">
                {t(locale, 'programs.joinCta')}
              </a>
            )}
          </ProgramSection>
          {part.quotes.map((citation) => (
            <QuoteBand
              class={citation.pinned ? undefined : 'js-quote-band'}
              name={citation.name}
              photo={citation.photo}
              quote={citation.quote}
              href={citation.href}
            />
          ))}
        </>
      ))
    })
  }

  {
    citations
      .filter((c) => c.afterSection >= sections.length)
      .map((citation) => (
        <QuoteBand
          class={citation.pinned ? undefined : 'js-quote-band'}
          name={citation.name}
          photo={citation.photo}
          quote={citation.quote}
          href={citation.href}
        />
      ))
  }

  {
    contributors.length > 0 && (
      <p class="content-max text-harmaa mx-auto px-4 py-10 sm:px-6">
        {t(locale, 'programs.contributors')}{' '}
        {contributors.map((c, i) => (
          <>
            {i > 0 && ', '}
            <a href={c.href} class="underline">
              {c.name}
            </a>
          </>
        ))}
      </p>
    )
  }

  {
    program.data.slides && (
      <ProgramSlides
        locale={locale}
        slides={program.data.slides}
        title={program.data.title}
        url={canonical}
      />
    )
  }

  <ShuffleOnLoad selector=".js-quote-band" />
  <ShuffleOnLoad selector="#program-creators > li" />
</BaseLayout>
