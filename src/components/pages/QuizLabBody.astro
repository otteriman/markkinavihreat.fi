---
import BaseLayout from '../../layouts/BaseLayout.astro'
import { resultTypes } from '../../lib/quiz/data'
import { renderTree, TREE_STYLES, type TreeInput, type TreeStyle } from '../../lib/quiz/tree'
import type { Axis } from '../../lib/quiz/types'

// Development and preview only (see src/pages/[lab].astro): a review sheet for
// the generated tree. Finnish only, like the rest of the team's tooling.
const mid = { markets: 50, environment: 50, freedom: 50 }
const STYLE_NAMES: Record<TreeStyle, string> = {
  flat: 'A · Litteä ja geometrinen',
  line: 'B · Viivapiirros',
  paper: 'C · Paperileikkaus',
}
const sample = { growth: 1, markets: 70, environment: 40, freedom: 60 }
// Static figures carry their input, so the style switch can redraw them.
const tree = (input: TreeInput) => JSON.stringify(input)
const stages = Array.from({ length: 10 }, (_, i) => (i + 1) / 10)
const axes: { axis: Axis; label: string; low: string; high: string }[] = [
  { axis: 'markets', label: 'Markkinat → hedelmät', low: 'omenat', high: 'kolikot ja setelit' },
  { axis: 'freedom', label: 'Vapaus → latvus', low: 'leikattu', high: 'villi' },
  {
    axis: 'environment',
    label: 'Ympäristö → elämä',
    low: 'siisti puutarha',
    high: 'kukat, mehiläiset, linnut',
  },
]
---

<BaseLayout
  locale="fi"
  title="Puulaboratorio — markkinavihreat.fi"
  description="Testin puun kehitysnäkymä."
  path="/quiz-lab/"
  noindex
>
  <div class="mx-auto max-w-6xl px-4 py-10 sm:px-6">
    <p class="text-eyebrow text-harmaa">Kehitysnäkymä · kolme tyylivaihtoehtoa</p>
    <h1 class="mt-2 text-4xl">Puulaboratorio</h1>
    <p class="mt-4 max-w-2xl">
      Puu piirretään koodilla. Koko riippuu vain kasvusta (yksi vaihe per vastattu kysymys);
      vastaukset muuttavat vain puun luonnetta: hedelmät, latvuksen muodon ja elämän puun ympärillä.
    </p>

    <section class="mt-10">
      <h2 class="text-2xl">Tyylit rinnakkain</h2>
      <p class="text-harmaa mt-1 text-sm">Sama puu, samat vastaukset, kolme piirustustyyliä.</p>
      <div class="mt-4 grid gap-3 sm:grid-cols-3">
        {
          TREE_STYLES.map((style) => (
            <figure class="card bg-white p-2 sm:p-2">
              <Fragment set:html={renderTree({ ...sample, style })} />
              <figcaption class="text-center text-sm font-semibold">
                {STYLE_NAMES[style]}
              </figcaption>
            </figure>
          ))
        }
      </div>
    </section>

    <fieldset id="lab-style" class="card mt-10 bg-white">
      <legend class="text-sm font-semibold">Näytä alla tyylillä</legend>
      <div class="mt-2 flex flex-wrap gap-4">
        {
          TREE_STYLES.map((style, i) => (
            <label class="flex items-center gap-2 text-sm">
              <input
                type="radio"
                name="style"
                value={style}
                checked={i === 0}
                class="accent-vihrea-tumma"
              />
              {STYLE_NAMES[style]}
            </label>
          ))
        }
      </div>
    </fieldset>

    <section class="mt-10">
      <h2 class="text-2xl">Kokeile</h2>
      <div class="mt-4 grid gap-6 md:grid-cols-[minmax(0,36rem)_18rem]">
        <div
          id="lab-tree"
          class="card bg-white p-2 sm:p-2"
          set:html={renderTree({ growth: 1, ...mid })}
        />
        <form id="lab-controls" class="card space-y-4 bg-white">
          <button
            type="button"
            id="lab-play"
            class="btn-primary w-full justify-center disabled:opacity-50"
          >
            ▶ Toista kasvu
          </button>
          {
            (
              [
                { name: 'growth', label: 'Kasvu', value: 10, min: 1, max: 10 },
                { name: 'markets', label: 'Markkinat', value: 50, min: 0, max: 100 },
                { name: 'freedom', label: 'Vapaus', value: 50, min: 0, max: 100 },
                { name: 'environment', label: 'Ympäristö', value: 50, min: 0, max: 100 },
              ] as const
            ).map(({ name, label, value, min, max }) => (
              <label class="block text-sm font-semibold">
                {label}:{' '}
                <output data-for={name}>{name === 'growth' ? `${value}/10` : value}</output>
                <input
                  type="range"
                  name={name}
                  min={min}
                  max={max}
                  value={value}
                  step="1"
                  class="accent-vihrea-tumma mt-1 w-full"
                />
              </label>
            ))
          }
        </form>
      </div>
    </section>

    <section class="mt-12">
      <h2 class="text-2xl">Kasvuvaiheet 1–10</h2>
      <p class="text-harmaa mt-1 text-sm">
        Kaikki akselit 50. Hedelmät vain kolmessa viimeisessä vaiheessa.
      </p>
      <div class="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-5">
        {
          stages.map((g, i) => (
            <figure class="card bg-white p-2 sm:p-2">
              <div
                data-tree={tree({ growth: g, ...mid })}
                set:html={renderTree({ growth: g, ...mid })}
              />
              <figcaption class="text-harmaa text-center text-xs">Vaihe {i + 1}</figcaption>
            </figure>
          ))
        }
      </div>
    </section>

    <section class="mt-12">
      <h2 class="text-2xl">Akselien ääripäät</h2>
      <p class="text-harmaa mt-1 text-sm">
        Täysi kasvu, muut akselit 50. Kummankin pään pitää näyttää yhtä houkuttelevalta.
      </p>
      {
        axes.map(({ axis, label, low, high }) => (
          <div class="mt-6">
            <h3 class="text-lg">{label}</h3>
            <div class="mt-2 grid gap-3 sm:grid-cols-2">
              {[0, 100].map((v) => (
                <figure class="card bg-white p-2 sm:p-2">
                  <div
                    data-tree={tree({ growth: 1, ...mid, [axis]: v })}
                    set:html={renderTree({ growth: 1, ...mid, [axis]: v })}
                  />
                  <figcaption class="text-harmaa text-center text-xs">
                    {v} – {v === 0 ? low : high}
                  </figcaption>
                </figure>
              ))}
            </div>
          </div>
        ))
      }
    </section>

    <section class="mt-12">
      <h2 class="text-2xl">Tulostyyppien puut</h2>
      <div class="mt-4 grid gap-3 sm:grid-cols-3">
        {
          resultTypes.map((r) => (
            <figure class="card bg-white p-2 sm:p-2">
              <div
                data-tree={tree({ growth: 1, ...r.representative })}
                set:html={renderTree({ growth: 1, ...r.representative }, r.name.fi)}
              />
              <figcaption class="text-center text-sm font-semibold">{r.name.fi}</figcaption>
            </figure>
          ))
        }
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  import { renderTree, type TreeStyle } from '../../lib/quiz/tree'
  import { TreeView } from '../../lib/quiz/treeView'

  const form = document.getElementById('lab-controls') as HTMLFormElement | null
  const target = document.getElementById('lab-tree')
  const play = document.getElementById('lab-play') as HTMLButtonElement | null
  if (form && target && play) {
    const input = (name: string) => form.elements.namedItem(name) as HTMLInputElement
    const styleOf = () =>
      ((document.querySelector('#lab-style input:checked') as HTMLInputElement | null)?.value ??
        'flat') as TreeStyle
    const read = () => ({
      style: styleOf(),
      growth: Number(input('growth').value) / 10,
      markets: Number(input('markets').value),
      environment: Number(input('environment').value),
      freedom: Number(input('freedom').value),
    })
    const showValues = () => {
      for (const out of form.querySelectorAll<HTMLOutputElement>('output[data-for]')) {
        const name = out.dataset.for!
        out.textContent = name === 'growth' ? `${input(name).value}/10` : input(name).value
      }
    }
    const view = new TreeView(target, read())

    // Switching style redraws every figure below, and the explorer, at once.
    document.getElementById('lab-style')?.addEventListener('change', () => {
      const style = styleOf()
      for (const el of document.querySelectorAll<HTMLElement>('[data-tree]')) {
        el.innerHTML = renderTree({ ...JSON.parse(el.dataset.tree!), style })
      }
      void view.set(read(), false)
    })
    let playing = 0

    form.addEventListener('input', () => {
      playing++ // moving a slider stops a running playback
      play.disabled = false
      showValues()
      void view.set(read())
    })

    // Grows the tree from a seedling to full size with the chosen traits,
    // one stage at a time, as it would during the quiz.
    play.addEventListener('click', async () => {
      const run = ++playing
      play.disabled = true
      for (let stage = 1; stage <= 10 && run === playing; stage++) {
        input('growth').value = String(stage)
        showValues()
        await view.set(read(), stage > 1)
        await new Promise((r) => setTimeout(r, 450))
      }
      if (run === playing) play.disabled = false
    })
  }
</script>
