---
import BaseLayout from '../../layouts/BaseLayout.astro'
import FinaleIcon from '../FinaleIcon.astro'
import QuizBars from '../QuizBars.astro'
import { items, resultTypes, t } from '../../lib/quiz/data'
import { renderTree, type TreeInput } from '../../lib/quiz/tree'
import type { Axis, Finale } from '../../lib/quiz/types'

// Development and preview only (see src/pages/[lab].astro): a review sheet for
// the generated tree, style C (paper-cut). Finnish only, like the rest of the
// team's tooling.
const mid = { markets: 50, environment: 50, freedom: 50 }
const stages = Array.from({ length: 10 }, (_, i) => (i + 1) / 10)
const axes: { axis: Axis; label: string; low: string; high: string }[] = [
  { axis: 'markets', label: 'Markkinat → hedelmät', low: 'omenat', high: 'kolikot ja setelit' },
  { axis: 'freedom', label: 'Vapaus → latvus', low: 'leikattu', high: 'villi' },
  {
    axis: 'environment',
    label: 'Ympäristö → elämä',
    low: 'siisti puutarha',
    high: 'kukat, mehiläiset, linnut',
  },
]
const finale = items.find((i): i is Finale => i.kind === 'finale')!
const tree = (input: TreeInput) => renderTree(input)
const CUES = [
  'markets.up',
  'markets.down',
  'freedom.up',
  'freedom.down',
  'environment.up',
  'environment.down',
  'neutral',
  'skipped',
]
const labConfig = {
  overall: t('fi', 'result.overall', { percent: '{percent}' }),
  status: t('fi', 'reveal.status', { percent: '{percent}', type: '{type}' }),
  types: Object.fromEntries(resultTypes.map((r) => [r.slug, r.name.fi])),
}
---

<BaseLayout
  locale="fi"
  title="Puulaboratorio — markkinavihreat.fi"
  description="Testin puun kehitysnäkymä."
  path="/quiz-lab/"
  noindex
>
  <div class="mx-auto max-w-6xl px-4 py-10 sm:px-6">
    <p class="text-eyebrow text-harmaa">Kehitysnäkymä · tyyli C: paperileikkaus</p>
    <h1 class="mt-2 text-4xl">Puulaboratorio</h1>
    <p class="mt-4 max-w-2xl">
      Puu piirretään koodilla. Koko riippuu vain kasvusta (yksi vaihe per vastattu kysymys);
      vastaukset muuttavat vain puun luonnetta: hedelmät, latvuksen muodon ja elämän puun ympärillä.
    </p>

    <section class="mt-10">
      <h2 class="text-2xl">Kokeile</h2>
      <div class="mt-4 grid gap-6 md:grid-cols-[minmax(0,36rem)_18rem]">
        <div>
          <div
            id="lab-tree"
            class="card bg-white p-2 sm:p-2"
            set:html={tree({ growth: 1, ...mid })}
          />
          <!-- Same markup hooks as the quiz's reveal screen, for the replay. -->
          <div id="lab-reveal" class="mt-4 text-center">
            <p data-reveal-drumroll class="text-eyebrow text-harmaa">
              {t('fi', 'finale.drumroll')}
            </p>
            <p data-reveal-percent class="text-display tabular-nums">
              {t('fi', 'result.overall', { percent: 0 })}
            </p>
            <p
              data-reveal-type
              class="mt-1 text-2xl font-extrabold opacity-0 transition-opacity duration-500"
            >
            </p>
            <div class="mt-3 text-left"><QuizBars locale="fi" group="reveal" /></div>
            <p data-reveal-status class="sr-only" aria-live="polite"></p>
          </div>
        </div>
        <form id="lab-controls" class="card space-y-4 self-start bg-white">
          <button
            type="button"
            id="lab-play"
            class="btn-primary w-full justify-center disabled:opacity-50"
          >
            ▶ Toista kasvu
          </button>
          <button
            type="button"
            id="lab-reveal-play"
            class="btn-outline-medium w-full justify-center disabled:opacity-50"
          >
            ▶ Toista tulospaljastus
          </button>
          {
            (
              [
                { name: 'growth', label: 'Kasvu', value: 10, min: 1, max: 10 },
                { name: 'markets', label: 'Markkinat', value: 50, min: 0, max: 100 },
                { name: 'freedom', label: 'Vapaus', value: 50, min: 0, max: 100 },
                { name: 'environment', label: 'Ympäristö', value: 50, min: 0, max: 100 },
              ] as const
            ).map(({ name, label, value, min, max }) => (
              <label class="block text-sm font-semibold">
                {label}:{' '}
                <output data-for={name}>{name === 'growth' ? `${value}/10` : value}</output>
                <input
                  type="range"
                  name={name}
                  min={min}
                  max={max}
                  value={value}
                  step="1"
                  class="accent-vihrea-tumma mt-1 w-full"
                />
              </label>
            ))
          }
        </form>
      </div>
    </section>

    <section class="mt-12">
      <h2 class="text-2xl">Kasvuvaiheet 1–10</h2>
      <p class="text-harmaa mt-1 text-sm">
        Kaikki akselit 50. Hedelmät vain kolmessa viimeisessä vaiheessa.
      </p>
      <div class="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-5">
        {
          stages.map((g, i) => (
            <figure class="card bg-white p-2 sm:p-2">
              <Fragment set:html={tree({ growth: g, ...mid })} />
              <figcaption class="text-harmaa text-center text-xs">Vaihe {i + 1}</figcaption>
            </figure>
          ))
        }
      </div>
    </section>

    <section class="mt-12">
      <h2 class="text-2xl">Akselien ääripäät</h2>
      <p class="text-harmaa mt-1 text-sm">
        Täysi kasvu, muut akselit 50. Kummankin pään pitää näyttää yhtä houkuttelevalta.
      </p>
      {
        axes.map(({ axis, label, low, high }) => (
          <div class="mt-6">
            <h3 class="text-lg">{label}</h3>
            <div class="mt-2 grid gap-3 sm:grid-cols-2">
              {[0, 100].map((v) => (
                <figure class="card bg-white p-2 sm:p-2">
                  <Fragment set:html={tree({ growth: 1, ...mid, [axis]: v })} />
                  <figcaption class="text-harmaa text-center text-xs">
                    {v} – {v === 0 ? low : high}
                  </figcaption>
                </figure>
              ))}
            </div>
          </div>
        ))
      }
    </section>

    <section class="mt-12">
      <h2 class="text-2xl">Tulostyyppien puut</h2>
      <div class="mt-4 grid gap-3 sm:grid-cols-3">
        {
          resultTypes.map((r) => (
            <figure class="card bg-white p-2 sm:p-2">
              <Fragment set:html={renderTree({ growth: 1, ...r.representative }, r.name.fi)} />
              <figcaption class="text-center text-sm font-semibold">{r.name.fi}</figcaption>
            </figure>
          ))
        }
      </div>
    </section>

    <section class="mt-12">
      <h2 class="text-2xl">Kasvun suunta vastauksen jälkeen</h2>
      <p class="text-harmaa mt-1 text-sm">
        Vastauksen jälkeen näytetään vain kasvava puu ja yksi lause siitä, mitä vastaus kertoi.
        Luonnoksia: kaikki kieliversiot odottavat tarkistusta.
      </p>
      <div class="mt-4 grid gap-3 sm:grid-cols-2">
        {
          CUES.map((k) => (
            <div class="card bg-white text-center">
              <p class="text-eyebrow text-harmaa">{k}</p>
              <p class="mt-2 text-xl font-extrabold">{t('fi', `cue.${k}`)}</p>
            </div>
          ))
        }
      </div>
    </section>

    <section class="mt-12">
      <h2 class="text-2xl">Finaalin kuvitukset</h2>
      <div class="mt-4 grid gap-3 sm:grid-cols-3">
        {
          finale.options.map((o) => (
            <div class="card flex items-center gap-4 bg-white text-lg font-semibold">
              <FinaleIcon option={o.id} />
              <span>{o.label.fi}</span>
            </div>
          ))
        }
      </div>
    </section>

    <script
      type="application/json"
      id="lab-config"
      is:inline
      set:html={JSON.stringify(labConfig)}
    />
  </div>
</BaseLayout>

<script>
  import { resultFromScores } from '../../lib/quiz/scoring'
  import { TreeView } from '../../lib/quiz/treeView'
  import { runReveal } from '../../scripts/quiz/reveal'

  const form = document.getElementById('lab-controls') as HTMLFormElement | null
  const target = document.getElementById('lab-tree')
  const play = document.getElementById('lab-play') as HTMLButtonElement | null
  const replay = document.getElementById('lab-reveal-play') as HTMLButtonElement | null
  const reveal = document.getElementById('lab-reveal')
  const config = JSON.parse(document.getElementById('lab-config')?.textContent ?? '{}') as {
    overall: string
    status: string
    types: Record<string, string>
  }
  if (form && target && play && replay && reveal) {
    const input = (name: string) => form.elements.namedItem(name) as HTMLInputElement
    const scores = () => ({
      markets: Number(input('markets').value),
      environment: Number(input('environment').value),
      freedom: Number(input('freedom').value),
    })
    const read = () => ({ growth: Number(input('growth').value) / 10, ...scores() })
    const showValues = () => {
      for (const out of form.querySelectorAll<HTMLOutputElement>('output[data-for]')) {
        const name = out.dataset.for!
        out.textContent = name === 'growth' ? `${input(name).value}/10` : input(name).value
      }
    }
    const view = new TreeView(target, read())
    let playing = 0
    const busy = (on: boolean) => {
      play.disabled = on
      replay.disabled = on
    }

    form.addEventListener('input', () => {
      playing++ // moving a slider stops a running playback
      busy(false)
      showValues()
      void view.set(read())
    })

    // Grows the tree from a seedling to full size with the chosen traits,
    // one stage at a time, as it would during the quiz.
    play.addEventListener('click', async () => {
      const run = ++playing
      busy(true)
      for (let stage = 1; stage <= 10 && run === playing; stage++) {
        input('growth').value = String(stage)
        showValues()
        await view.set(read(), stage > 1)
        await new Promise((r) => setTimeout(r, 450))
      }
      if (run === playing) busy(false)
    })

    // Replays the quiz's result reveal with the chosen scores.
    replay.addEventListener('click', async () => {
      const run = ++playing
      busy(true)
      input('growth').value = '9'
      showValues()
      await view.set(read(), false)
      const result = resultFromScores(scores())
      await runReveal(
        {
          section: reveal,
          treeWrap: target,
          view,
          overall: config.overall,
          status: config.status,
          typeName: config.types[result.type],
        },
        result,
        matchMedia('(prefers-reduced-motion: reduce)').matches,
      )
      input('growth').value = '10'
      showValues()
      if (run === playing) busy(false)
    })
  }
</script>
