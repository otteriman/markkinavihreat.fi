---
import { renderInlineMarkdown } from '../lib/markdown'
import type { Locale } from '../lib/content'
import type { ProgramParagraph } from '../lib/programSections'
import RuokaostostukiAlvChart from './charts/RuokaostostukiAlvChart.astro'
import KymmenenKolikkoaChart from './charts/KymmenenKolikkoaChart.astro'
import TunnitJaRahaChart from './charts/TunnitJaRahaChart.astro'
import TilinauhaChart from './charts/TilinauhaChart.astro'
import YouTubeEmbed from './YouTubeEmbed.astro'
import ProgramImage from './ProgramImage.astro'
import ProgramDisclosure from './ProgramDisclosure.astro'
import type { UiKey } from '../i18n/ui'

// Charts registered for the "[kuvaaja: <id>]" marker (see lib/programSections.ts).
// Add new chart components here as they're built — a program body referencing
// an id not listed here fails the build, the same way an unknown citation
// person does in ProgramDetailBody.astro.
const CHARTS = {
  'ruokaostostuki-alv': RuokaostostukiAlvChart,
  'kymmenen-kolikkoa': KymmenenKolikkoaChart,
  'tunnit-ja-raha': TunnitJaRahaChart,
  tilinauha: TilinauhaChart,
} as const

// Images registered for the "[kuva: <id>]" marker (see lib/programSections.ts).
const IMAGES: Record<string, { src: string; altKey: UiKey }> = {
  'ruuan-alv-esimerkki': {
    src: '/programs/ruuan_alv/Ruuan_ALV_infografiikka.jpg',
    altKey: 'image.ruuanAlvEsimerkki.alt',
  },
}

interface Props {
  /**
   * `dark` — the framing/summary highlight bands (bg-metsa).
   * `light` / `tint` — alternating backgrounds for numbered requirement bands.
   */
  tone: 'dark' | 'light' | 'tint'
  /** Eyebrow label above the heading, e.g. "Vaatimus 1 / 5". */
  label?: string
  /** Left out on the continuation of a section that a quote band splits. */
  heading?: string
  paragraphs: ProgramParagraph[]
  /**
   * Index of `paragraphs[0]` within the whole section, so only the section's
   * real first paragraph gets the lead style when a quote band splits it.
   */
  firstParagraphIndex?: number
  /** Needed only for locale-aware chart rendering (labels, number formatting). */
  locale: Locale
}

const { tone, label, heading, paragraphs, firstParagraphIndex = 0, locale } = Astro.props

const TONE_STYLES = {
  dark: {
    section: 'bg-metsa text-kerma',
    prose: 'prose-body-dark',
    eyebrow: 'text-vihrea',
    quoteBorder: 'border-vihrea',
  },
  light: {
    section: 'bg-kerma text-musta',
    prose: 'prose-body',
    eyebrow: 'text-vihreat-brand',
    quoteBorder: 'border-vihreat-brand',
  },
  tint: {
    section: 'bg-surface-green text-metsa',
    prose: 'prose-body',
    eyebrow: 'text-metsa',
    quoteBorder: 'border-metsa',
  },
} as const

const styles = TONE_STYLES[tone]
---

<section class:list={['px-4 py-20 sm:px-6 sm:py-28', styles.section]}>
  <div class="content-max mx-auto">
    {label && <p class:list={['text-eyebrow mb-3', styles.eyebrow]}>{label}</p>}
    {heading && <h2 class="text-display mb-8">{heading}</h2>}
    <div class="space-y-4">
      {
        paragraphs.map((paragraph, i) => {
          if (paragraph.type === 'chart') {
            const Chart = CHARTS[paragraph.text as keyof typeof CHARTS]
            if (!Chart)
              throw new Error(`Program body references unknown chart id "${paragraph.text}"`)
            return <Chart locale={locale} />
          }
          if (paragraph.type === 'video') {
            return <YouTubeEmbed videoId={paragraph.text} locale={locale} />
          }
          if (paragraph.type === 'image') {
            const image = IMAGES[paragraph.text]
            if (!image)
              throw new Error(`Program body references unknown image id "${paragraph.text}"`)
            return <ProgramImage src={image.src} altKey={image.altKey} locale={locale} />
          }
          if (paragraph.type === 'disclosure') {
            if (!paragraph.question) throw new Error('Disclosure paragraph is missing its question')
            return (
              <ProgramDisclosure
                question={paragraph.question}
                answer={paragraph.text}
                proseClass={styles.prose}
              />
            )
          }
          if (paragraph.type === 'quote') {
            return (
              <blockquote
                class:list={['border-l-4 pl-6 text-xl font-semibold italic', styles.quoteBorder]}
                set:html={renderInlineMarkdown(paragraph.text)}
              />
            )
          }
          if (paragraph.type === 'attribution') {
            return <p class="text-sm font-semibold opacity-70">{paragraph.text}</p>
          }
          return (
            <p
              class:list={[
                styles.prose,
                tone === 'dark'
                  ? 'text-lg leading-relaxed opacity-90'
                  : firstParagraphIndex + i === 0
                    ? 'text-lg font-medium'
                    : 'text-base',
              ]}
              set:html={renderInlineMarkdown(paragraph.text)}
            />
          )
        })
      }
    </div>
    <slot />
  </div>
</section>
