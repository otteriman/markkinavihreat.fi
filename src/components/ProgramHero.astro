---
import { renderInlineMarkdown } from '../lib/markdown'
import type { ProgramParagraph } from '../lib/programSections'
import { heroSegments } from '../lib/heroLines'

interface Props {
  kicker: string
  /**
   * Display lines of the hero heading. `*word*` marks words for the accent
   * color; with no markers, the last line gets it (see lib/heroLines.ts).
   */
  lines: string[]
  leadParagraphs: ProgramParagraph[]
}

const { kicker, lines, leadParagraphs } = Astro.props
const segmentLines = heroSegments(lines)
---

<section
  class="content-max mx-auto flex min-h-[70svh] flex-col justify-center px-4 py-20 text-center sm:px-6"
>
  <p class="text-eyebrow text-vihreat-brand mb-6">{kicker}</p>
  <h1 class="text-display-lg mx-auto mb-6 max-w-[16ch] uppercase">
    {
      segmentLines.map((segments) => (
        <span class="block">
          {segments.map((segment) =>
            segment.accent ? <span class="text-vihreat-brand">{segment.text}</span> : segment.text,
          )}
        </span>
      ))
    }
  </h1>
  <div class="mx-auto max-w-[52ch] space-y-4">
    {
      leadParagraphs.map((paragraph) => (
        <p class="prose-body text-lg font-medium" set:html={renderInlineMarkdown(paragraph.text)} />
      ))
    }
  </div>
</section>
