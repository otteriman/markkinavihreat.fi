---
import { assetPath, type Locale } from '../lib/content'
import { t, type UiKey } from '../i18n/ui'

interface Props {
  /** Root-absolute path under public/, e.g. "/programs/ruuan_alv/....jpg". */
  src: string
  /** i18n key for the alt text — infographics need real alt text, not a filename. */
  altKey: UiKey
  locale: Locale
}

const { src, altKey, locale } = Astro.props
---

<img
  src={assetPath(src)}
  alt={t(locale, altKey)}
  loading="lazy"
  class="rounded-card mx-auto my-6 block w-full max-w-[360px]"
/>
