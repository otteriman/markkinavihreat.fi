---
import { tenEuroSplits, type ExtraPaySplit } from '../../lib/charts/tyonKannattavuus'
import { formatEuro } from '../../lib/format'
import type { Locale } from '../../lib/content'

// Kuva 1 of the tyosta-aina-kannattavaa draft, kept deliberately simple: ten
// one-euro coins per person, either "yours" (green) or gone (an empty
// outline), and one whole-euro figure. Where the gone euros go (taxes vs. the
// benefit cut) and the exact cents live in the "Miten luvut on laskettu?"
// disclosure in the program text, not here.
//
// With motion allowed and JavaScript on, every coin starts out green and the
// ones that aren't yours empty out one by one; without either, the final
// state shows.
//
// TODO(i18n): the copy is Finnish only while the program is a draft; it
// moves to src/i18n/ui.ts with sv/en translations once the draft is approved.

interface Props {
  locale: Locale
}

const { locale } = Astro.props

const splits = tenEuroSplits()

const rows = [
  { name: 'IT-asiantuntija', split: splits.itSpecialist },
  { name: 'Yksinhuoltaja toimeentulotuella', split: splits.singleParent },
]

/** Ten coins, the first `kept` (rounded to whole euros) of them yours. */
function coins(split: ExtraPaySplit): boolean[] {
  const kept = Math.round(split.kept)
  return Array.from({ length: 10 }, (_, i) => i < kept)
}
---

<figure class="my-10" data-coins>
  <figcaption class="mb-8 text-2xl leading-tight font-extrabold sm:text-3xl">
    Kun tienaat kympin lisää, paljonko siitä jää sinulle?
  </figcaption>

  <div class="space-y-8">
    {
      rows.map((row) => (
        <div>
          <div class="mb-3 flex items-baseline justify-between gap-4">
            <p class="text-lg font-bold">{row.name}</p>
            <p class="text-4xl font-extrabold tabular-nums">{formatEuro(row.split.kept, locale)}</p>
          </div>
          <ol class="flex gap-1.5 sm:gap-2" aria-hidden="true">
            {coins(row.split).map((yours, i) => (
              <li class="coin" data-yours={yours ? '' : undefined} style={`--i: ${i}`}>
                <span>€</span>
              </li>
            ))}
          </ol>
          <p class="sr-only">
            {row.name}: kympistä jää {formatEuro(row.split.kept, locale)}.
          </p>
        </div>
      ))
    }
  </div>
</figure>

<style>
  .coin {
    flex: 1 1 0;
    max-width: 3.25rem;
    aspect-ratio: 1;
    border-radius: 9999px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 800;
    font-size: clamp(0.75rem, 3vw, 1.1rem);
    /* A euro that isn't yours: an empty, dashed outline where a coin was. The
       outline takes the surrounding text colour, so it reads on any band. */
    background-color: transparent;
    border: 2px dashed currentColor;
    opacity: 0.45;
    transition:
      background-color 450ms ease,
      border-color 450ms ease,
      opacity 450ms ease;
    transition-delay: calc(var(--i) * 90ms);
  }
  .coin span {
    visibility: hidden;
  }
  .coin[data-yours],
  [data-coins].is-armed:not(.is-in) .coin {
    background-color: var(--color-vihrea);
    border-color: transparent;
    color: var(--color-metsa);
    opacity: 1;
  }
  .coin[data-yours] span,
  [data-coins].is-armed:not(.is-in) .coin span {
    visibility: visible;
  }
  /* Before the figure scrolls into view, every coin is still "yours". */
  [data-coins].is-armed:not(.is-in) .coin {
    transition-delay: 0ms;
  }
</style>

<script>
  // Arms the coin animation only when motion is welcome; without this script
  // the coins simply show their final state.
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches
  if (!reduceMotion && 'IntersectionObserver' in window) {
    document.querySelectorAll<HTMLElement>('[data-coins]').forEach((figure) => {
      figure.classList.add('is-armed')
      const observer = new IntersectionObserver(
        (entries) => {
          if (entries.some((entry) => entry.isIntersecting)) {
            // A short pause lets the reader see the all-green rows first.
            window.setTimeout(() => figure.classList.add('is-in'), 700)
            observer.disconnect()
          }
        },
        { threshold: 0.35 },
      )
      observer.observe(figure)
    })
  }
</script>
